<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.hermes.router</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/shailja/clawd/router/run_router.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/shailja/clawd/router</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/shailja/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/shailja</string>
        <key>HERMES_ROUTER_FOREGROUND</key>
