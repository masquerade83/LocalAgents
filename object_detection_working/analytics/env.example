# Copy to .env in object_detection_working/ or export these before running server_yolo.py
# For loading .env you can use: pip install python-dotenv and load_dotenv() in server_yolo.py

# ---------- Email (SMTP) ----------
ANALYTICS_SMTP_HOST=smtp.gmail.com
ANALYTICS_SMTP_PORT=587
ANALYTICS_SMTP_USER=your-email@gmail.com
ANALYTICS_SMTP_PASS=your-app-password
ANALYTICS_ALERT_EMAIL_FROM=your-email@gmail.com
ANALYTICS_ALERT_EMAIL_TO=kush.sood@gmail.com

# ---------- SMS (Twilio) ----------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890
ANALYTICS_ALERT_PHONE_TO=+919876543210,+919876543211

# ---------- WhatsApp (Twilio WhatsApp API) ----------
# Same Twilio account as SMS. From = WhatsApp sandbox or approved Business number.
# Sandbox: https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
#   Join sandbox by sending the code to the Twilio WhatsApp number, then use:
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ANALYTICS_ALERT_WHATSAPP_TO=whatsapp:+919625940534
