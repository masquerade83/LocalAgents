# Neo4j (matches neo4j/docker-compose.yml defaults)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_local_dev

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# Corpus path (absolute or relative to repo root)
WHITEPAPERS_PATH=../../whitepapers

# Extraction tuning
RAG_CHUNK_CHARS=6000
OLLAMA_TIMEOUT=300
